+            }
+        }
+        rule.runOnIdle { owner.registry.currentState = Lifecycle.State.STARTED }
+        rule.waitForIdle()
+        rule.runOnIdle { owner.registry.currentState = Lifecycle.State.CREATED }
+        android.os.SystemClock.sleep(450)
+        rule.runOnIdle {
+            assertNotNull(state.current)
